{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rbb:land_corner_dot",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/rbb_land_corner_dot"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.04
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 4.8
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.sin(variable.particle_age * 2.8) * 0.018",
          "math.sin(variable.particle_age * 3.6) * 0.045",
          "math.cos(variable.particle_age * 2.8) * 0.018"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.48 + math.sin(variable.particle_age * 6.5) * 0.07",
          "0.48 + math.sin(variable.particle_age * 6.5) * 0.07"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [0, 0],
          "uv_size": [32, 32]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * math.min(variable.particle_age * 4, 1) * math.min((4.8 - variable.particle_age) * 1.8, 1) * (0.82 + math.sin(variable.particle_age * 7) * 0.18)"
        ]
      }
    }
  }
}
