{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rbb:land_ground_band",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/rbb_land_ground_band"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.04
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 4.4
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          0,
          "0.018 + math.sin(variable.particle_age * 2.8) * 0.018",
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "1.34 + math.sin(variable.particle_age * 4.2) * 0.12",
          "0.3 + math.sin(variable.particle_age * 4.2) * 0.035"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 16,
          "uv": [0, 0],
          "uv_size": [64, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * 1.16 * math.min(variable.particle_age * 4.2, 1) * math.min((4.4 - variable.particle_age) * 1.7, 1) * (0.9 + math.sin(variable.particle_age * 5.2) * 0.1)"
        ]
      }
    }
  }
}
