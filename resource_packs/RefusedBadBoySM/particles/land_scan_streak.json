{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rbb:land_scan_streak",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/rbb_land_scan_streak"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.04
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.85
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          0,
          "variable.particle_age * 0.05",
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "1.18 + math.sin(variable.particle_age * 10) * 0.08",
          "0.28 + math.sin(variable.particle_age * 10) * 0.025"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 16,
          "uv": [0, 0],
          "uv_size": [64, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * math.min(variable.particle_age * 10, 1) * math.min((0.85 - variable.particle_age) * 5, 1)"
        ]
      }
    }
  }
}
