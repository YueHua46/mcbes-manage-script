{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rbb:land_boundary_spire",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/rbb_land_boundary_spire"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 1 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.04 },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": { "max_lifetime": 5.0 },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.sin(variable.particle_age * 72) * 0.025",
          "math.sin(variable.particle_age * 36) * 0.035",
          "math.cos(variable.particle_age * 72) * 0.025"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.46 + math.sin(variable.particle_age * 68) * 0.018",
          "1.14 + math.sin(variable.particle_age * 54) * 0.045"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 128,
          "texture_height": 256,
          "uv": [0, 0],
          "uv_size": [128, 256]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * (0.78 + math.sin(variable.particle_age * 68) * 0.12) * math.min(variable.particle_age * 3.5, 1) * math.min((5.0 - variable.particle_age) * 1.8, 1)"
        ]
      }
    }
  }
}
