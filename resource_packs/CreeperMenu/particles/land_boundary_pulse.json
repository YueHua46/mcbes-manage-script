{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rbb:land_boundary_pulse",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/rbb_land_boundary_orb"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 1 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.04 },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": { "max_lifetime": 0.85 },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_appearance_billboard": {
        "size": ["0.22 - variable.particle_age * 0.06", "0.22 - variable.particle_age * 0.06"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [0, 0],
          "uv_size": [128, 128]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * math.min(variable.particle_age * 10, 1) * math.min((0.85 - variable.particle_age) * 2.4, 1)"
        ]
      }
    }
  }
}
