{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rbb:land_mote_corner",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/rbb_land_mote_corner"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.duration"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.42 * variable.size_scale * (0.99 + math.sin((variable.particle_age + variable.clock) * 40 + variable.phase) * 0.01)",
          "0.42 * variable.size_scale * (0.99 + math.sin((variable.particle_age + variable.clock) * 40 + variable.phase) * 0.01)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * math.clamp(variable.particle_age / variable.fade, 0, 1) * math.clamp((variable.duration - variable.particle_age) / variable.fade, 0, 1)"
        ]
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_initial_spin": {
        "rotation": 0,
        "rotation_rate": 0
      }
    }
  }
}
