{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rbb:land_anchor_ring",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/rbb_land_anchor_ring"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.04
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 5.0
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.sin(variable.particle_age * 1.8) * 0.018",
          "math.sin(variable.particle_age * 2.4) * 0.035",
          "math.cos(variable.particle_age * 1.8) * 0.018"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.86 + math.sin(variable.particle_age * 3.6) * 0.08",
          "0.86 + math.sin(variable.particle_age * 3.6) * 0.08"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [0, 0],
          "uv_size": [64, 64]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * math.min(variable.particle_age * 3, 1) * math.min((5.0 - variable.particle_age) * 1.4, 1) * (0.78 + math.sin(variable.particle_age * 5.6) * 0.22)"
        ]
      }
    }
  }
}
