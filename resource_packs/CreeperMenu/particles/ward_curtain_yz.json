{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rbb:ward_curtain_yz",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/rbb_ward_curtain"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.duration"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.panel_width / 2",
          "variable.panel_height / 2"
        ],
        "facing_camera_mode": "direction_z",
        "direction": {
          "mode": "custom_direction",
          "custom_direction": [
            1,
            0,
            0
          ]
        },
        "uv": {
          "texture_width": 128,
          "texture_height": 2048,
          "uv": [
            "1 + variable.uv_u * 126",
            "math.mod(math.floor(variable.animation_phase + variable.particle_age * 8), 16) * 128 + 1 + variable.uv_v * 126"
          ],
          "uv_size": [
            "variable.panel_width / 4 * 126",
            "variable.panel_height / 4 * 126"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * math.min(variable.particle_age / 0.15, 1) * math.min((variable.duration - variable.particle_age) / 0.15, 1)"
        ]
      }
    }
  }
}
