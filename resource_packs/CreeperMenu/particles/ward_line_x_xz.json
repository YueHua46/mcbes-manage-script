{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rbb:ward_line_x_xz",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/rbb_ward_line_h"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.duration"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.segment_length / 2",
          0.055
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 8,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * math.min(variable.particle_age / 0.15, 1) * math.min((variable.duration - variable.particle_age) / 0.15, 1)"
        ]
      }
    }
  }
}
