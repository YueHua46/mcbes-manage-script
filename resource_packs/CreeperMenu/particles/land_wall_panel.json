{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rbb:land_wall_panel",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/rbb_land_wall_panel"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.04
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 5.1
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.sin(variable.particle_age * 2.2) * 0.025",
          "math.sin(variable.particle_age * 2.8) * 0.04",
          "math.cos(variable.particle_age * 2.2) * 0.025"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.74 + math.sin(variable.particle_age * 3.8) * 0.06",
          "1.38 + math.sin(variable.particle_age * 2.8) * 0.12"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 64,
          "uv": [0, 0],
          "uv_size": [32, 64]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * math.min(variable.particle_age * 2.6, 1) * math.min((5.1 - variable.particle_age) * 1.2, 1) * (0.72 + math.sin(variable.particle_age * 5.4) * 0.2)"
        ]
      }
    }
  }
}
