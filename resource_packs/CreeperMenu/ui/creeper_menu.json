{
  "namespace": "creeper_menu",

  "long_form_router": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "main_menu@creeper_menu.form_type": {
          "$min": "/CMROOT ",
          "$max": "/CMROOT 􀐏",
          "$content": "creeper_menu.root"
        }
      },
      {
        "project_action_form@creeper_menu.form_type": {
          "$min": "/CMFORM ",
          "$max": "/CMFORM 􀐏",
          "$content": "creeper_menu.generic_long_form"
        }
      },
      {
        "project_message_form@creeper_menu.form_type": {
          "$min": "/CMMESSAGE ",
          "$max": "/CMMESSAGE 􀐏",
          "$content": "creeper_menu.message_form"
        }
      }
    ]
  },

  "form_type": {
    "type": "panel",
    "size": ["100%", "100%"],
    "visible": false,
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#title_text = $min) or (#title_text > $min and #title_text < $max)",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#title_text - $min)",
        "target_property_name": "#title"
      }
    ],
    "controls": [
      {
        "content@$content": {}
      }
    ]
  },

  "message_form@creeper_message.form": {},

  "root": {
    "type": "panel",
    "size": ["100%", "100%"],
    "variables": [
      {
        "requires": "$touch",
        "$cm_viewport_size": ["97%", "93%"],
        "$cm_title_scale": 0.82
      },
      {
        "requires": "(not $touch)",
        "$cm_viewport_size": ["95%", "92%"],
        "$cm_title_scale": 0.92
      }
    ],
    "controls": [
      {
        "viewport": {
          "type": "panel",
          "size": "$cm_viewport_size",
          "controls": [
            {
              "absolute_cap": {
                "type": "panel",
                "size": ["100%", "100%"],
                "max_size": [920, 510],
                "controls": [
                  {
                    "aspect_width_cap": {
                      "type": "panel",
                      "size": ["100%", "100%"],
                      "max_size": ["180.3922%y", "100%"],
                      "controls": [
                        {
                          "dialog": {
                            "type": "panel",
                            "size": ["100%", "100%"],
                            "max_size": ["100%", "55.4348%x"],
                            "layer": 2,
                            "controls": [
                              {
                                "header@creeper_menu.header": {}
                              },
                              {
                                "content@creeper_menu.content": {}
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "header": {
    "type": "panel",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "size": ["100%", 34],
    "offset": [0, 0],
    "layer": 6,
    "controls": [
      {
        "title": {
          "type": "label",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [3, 0],
          "text": "主菜单",
          "font_size": "large",
          "font_scale_factor": "$cm_title_scale",
          "color": [1.0, 0.98, 0.92],
          "shadow": true,
          "layer": 7
        }
      },
      {
        "close_button@creeper_menu.close_button": {
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [-3, 0]
        }
      }
    ]
  },

  "content": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "size": ["100%", "100% - 38px"],
    "offset": [0, -1],
    "layer": 4,
    "controls": [
      {
        "left@creeper_menu.left_mosaic": {}
      },
      {
        "column_gap": {
          "type": "panel",
          "size": [4, "100%"]
        }
      },
      {
        "right@creeper_menu.right_mosaic": {}
      }
    ]
  },

  "left_mosaic": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": ["66%", "100%"],
    "controls": [
      {
        "row_1@creeper_menu.row_one": {}
      },
      {
        "row_gap_1": {
          "type": "panel",
          "size": ["100%", 4]
        }
      },
      {
        "row_2@creeper_menu.row_two": {}
      },
      {
        "row_gap_2": {
          "type": "panel",
          "size": ["100%", 4]
        }
      },
      {
        "row_3@creeper_menu.row_three": {}
      }
    ]
  },

  "row_one": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": ["100%", "33.33% - 3px"],
    "collection_name": "form_buttons",
    "controls": [
      {
        "player@creeper_menu.card_player": {
          "size": ["33.33% - 3px", "100%"],
          "$cm_index": 0
        }
      },
      {
        "gap_1@creeper_menu.card_gap": {}
      },
      {
        "waypoint@creeper_menu.card_waypoint": {
          "size": ["33.33% - 3px", "100%"],
          "$cm_index": 1
        }
      },
      {
        "gap_2@creeper_menu.card_gap": {}
      },
      {
        "land@creeper_menu.card_land": {
          "size": ["33.34% - 2px", "100%"],
          "$cm_index": 2
        }
      }
    ]
  },

  "row_two": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": ["100%", "33.34% - 2px"],
    "collection_name": "form_buttons",
    "controls": [
      {
        "economy@creeper_menu.card_economy": {
          "size": ["50% - 2px", "100%"],
          "$cm_index": 3
        }
      },
      {
        "gap_1@creeper_menu.card_gap": {}
      },
      {
        "guild@creeper_menu.card_guild": {
          "size": ["50% - 2px", "100%"],
          "$cm_index": 4
        }
      }
    ]
  },

  "row_three": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": ["100%", "33.33% - 3px"],
    "collection_name": "form_buttons",
    "controls": [
      {
        "pvp@creeper_menu.card_pvp": {
          "size": ["33.33% - 3px", "100%"],
          "$cm_index": 6
        }
      },
      {
        "gap_1@creeper_menu.card_gap": {}
      },
      {
        "stats@creeper_menu.card_stats": {
          "size": ["33.33% - 3px", "100%"],
          "$cm_index": 7
        }
      },
      {
        "gap_2@creeper_menu.card_gap": {}
      },
      {
        "other@creeper_menu.card_other": {
          "size": ["33.34% - 2px", "100%"],
          "$cm_index": 9
        }
      }
    ]
  },

  "right_mosaic": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": ["34% - 4px", "100%"],
    "collection_name": "form_buttons",
    "controls": [
      {
        "quest@creeper_menu.card_quest": {
          "size": ["100%", "52% - 3px"],
          "$cm_index": 8
        }
      },
      {
        "right_gap_1@creeper_menu.card_gap_vertical": {}
      },
      {
        "menu_item@creeper_menu.card_menu_item": {
          "size": ["100%", "23% - 3px"],
          "$cm_index": 11
        }
      },
      {
        "right_gap_2@creeper_menu.card_gap_vertical": {}
      },
      {
        "quick_row": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": ["100%", "25% - 2px"],
          "collection_name": "form_buttons",
          "controls": [
            {
              "floating_text@creeper_menu.card_floating_text": {
                "size": ["33.33% - 3px", "100%"],
                "$cm_index": 5
              }
            },
            {
              "gap_1@creeper_menu.card_gap": {}
            },
            {
              "help@creeper_menu.card_help": {
                "size": ["33.33% - 3px", "100%"],
                "$cm_index": 10
              }
            },
            {
              "gap_2@creeper_menu.card_gap": {}
            },
            {
              "server_settings@creeper_menu.card_server_settings": {
                "size": ["33.34% - 2px", "100%"],
                "$cm_index": 12
              }
            }
          ]
        }
      }
    ]
  },

  "card_gap": {
    "type": "panel",
    "size": [4, "100%"]
  },

  "card_gap_vertical": {
    "type": "panel",
    "size": ["100%", 4]
  },

  "generic_long_form": {
    "type": "panel",
    "size": ["100%", "100%"],
    "variables": [
      {
        "requires": "$touch",
        "$cm_submenu_size": ["76%", "86%"]
      },
      {
        "requires": "(not $touch)",
        "$cm_submenu_size": ["48%", "76%"]
      }
    ],
    "controls": [
      {
        "dialog": {
          "type": "image",
          "size": "$cm_submenu_size",
          "max_size": [560, 420],
          "texture": "textures/ui/creeper_menu/submenu_panel",
          "layer": 2,
          "controls": [
            {
              "header@creeper_menu.generic_header": {}
            },
            {
              "content_frame": {
                "type": "image",
                "anchor_from": "bottom_middle",
                "anchor_to": "bottom_middle",
                "size": ["100% - 16px", "100% - 72px"],
                "offset": [0, -7],
                "texture": "textures/ui/creeper_menu/content_sheet",
                "layer": 3,
                "controls": [
                  {
                    "scroll@common.scrolling_panel": {
                      "size": ["100%", "100% - 10px"],
                      "$show_background": false,
                      "$scrolling_content": "creeper_menu.generic_long_form_content",
                      "$scroll_size": [2, "100%"],
                      "$scrolling_pane_size": ["100%", "100%"],
                      "$scroll_bar_right_padding_size": [0, 0],
                      "layer": 4
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "generic_header": {
    "type": "image",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "size": ["100% - 16px", 56],
    "offset": [0, 6],
    "texture": "textures/ui/creeper_menu/header_band",
    "controls": [
      {
        "emblem": {
          "type": "image",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [5, -2],
          "size": [43, 43],
          "texture": "textures/ui/creeper_menu/submenu_emblem",
          "layer": 7
        }
      },
      {
        "title": {
          "type": "label",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [50, -4],
          "size": ["100% - 94px", 20],
          "font_size": "large",
          "font_scale_factor": 0.76,
          "color": [1.0, 0.95, 0.8],
          "shadow": true,
          "layer": 6,
          "text": "#form_text",
          "bindings": [
            {
              "binding_name": "#form_text"
            }
          ]
        }
      },
      {
        "subtitle": {
          "type": "label",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [51, 7],
          "size": ["100% - 96px", 12],
          "text": "冒险手册 · 选择行动",
          "font_scale_factor": 0.52,
          "color": [0.82, 0.78, 0.61],
          "shadow": false,
          "localize": false,
          "layer": 6
        }
      },
      {
        "close_button@creeper_menu.close_button": {
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [-5, 0]
        }
      }
    ]
  },

  "generic_long_form_content": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": ["100% - 12px", "100%c"],
    "offset": [6, 0],
    "controls": [
      {
        "buttons": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": ["100%", "100%c"],
          "factory": {
            "name": "buttons",
            "control_ids": {
              "button": "creeper_menu.generic_dynamic_button",
              "label": "creeper_menu.generic_dynamic_label",
              "header": "creeper_menu.generic_dynamic_header",
              "divider": "creeper_menu.generic_dynamic_divider"
            }
          },
          "collection_name": "form_buttons",
          "bindings": [
            {
              "binding_name": "#form_button_contents",
              "binding_name_override": "#collection_length"
            }
          ]
        }
      }
    ]
  },

  "generic_dynamic_button": {
    "type": "panel",
    "size": ["100%", 39],
    "visible": false,
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_text",
        "binding_name_override": "#text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#text = ''))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "button@creeper_menu.generic_button": {}
      }
    ]
  },

  "generic_button@common.button": {
    "size": ["100%", 36],
    "$pressed_button_name": "button.form_button_click",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "locked_control": "locked",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      {
        "default@creeper_menu.generic_button_state": {
          "$cm_state_texture": "textures/ui/creeper_menu/cards/generic_default",
          "$cm_state_text_color": [0.2, 0.18, 0.16],
          "$cm_state_offset": [0, 0]
        }
      },
      {
        "hover@creeper_menu.generic_button_state": {
          "$cm_state_texture": "textures/ui/creeper_menu/cards/generic_hover",
          "$cm_state_text_color": [0.16, 0.14, 0.12],
          "$cm_state_offset": [0, 1]
        }
      },
      {
        "pressed@creeper_menu.generic_button_state": {
          "$cm_state_texture": "textures/ui/creeper_menu/cards/generic_pressed",
          "$cm_state_text_color": [0.29, 0.25, 0.21],
          "$cm_state_offset": [0, 2]
        }
      },
      {
        "locked@creeper_menu.generic_button_state": {
          "$cm_state_texture": "textures/ui/creeper_menu/cards/generic_default",
          "$cm_state_text_color": [0.52, 0.49, 0.44],
          "$cm_state_offset": [0, 0],
          "alpha": 0.55
        }
      }
    ]
  },

  "generic_button_state": {
    "type": "image",
    "size": ["100%", "100%"],
    "offset": "$cm_state_offset",
    "keep_ratio": false,
    "texture": "$cm_state_texture",
    "layer": 5,
    "controls": [
      {
        "accent_rail": {
          "type": "image",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [2, 0],
          "size": [3, 28],
          "texture": "textures/ui/creeper_menu/list_rail",
          "keep_ratio": false,
          "layer": 6
        }
      },
      {
        "label": {
          "type": "label",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [44, -1],
          "size": ["100% - 64px", "default"],
          "max_size": ["100% - 64px", 30],
          "text": "#form_button_text",
          "font_scale_factor": 0.66,
          "line_padding": -1,
          "text_alignment": "left",
          "color": "$cm_state_text_color",
          "layer": 7,
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      },
      {
        "icon_chip": {
          "type": "image",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [7, 0],
          "size": [28, 28],
          "texture": "textures/ui/creeper_menu/icon_chip",
          "layer": 7,
          "bindings": [
            {
              "binding_name": "#form_button_texture",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#form_button_texture = '') or (#form_button_texture = 'loading')))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "icon@creeper_menu.generic_button_icon": {
          "layer": 8
        }
      },
      {
        "chevron": {
          "type": "label",
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [-10, -1],
          "size": [10, 15],
          "text": "›",
          "font_size": "large",
          "font_scale_factor": 0.62,
          "color": [0.31, 0.45, 0.27],
          "layer": 9,
          "bindings": [
            {
              "binding_name": "#form_button_texture",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#form_button_texture - 'textures/icons/back' - 'textures/icons/left_arrow') = #form_button_texture)",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  "generic_dynamic_label": {
    "type": "label",
    "size": ["100% - 16px", "default"],
    "offset": [8, 5],
    "text": "#form_button_text",
    "color": [0.26, 0.23, 0.2],
    "font_scale_factor": 0.68,
    "line_padding": 1,
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      }
    ]
  },

  "generic_dynamic_header@creeper_menu.generic_dynamic_label": {
    "font_size": "large",
    "font_scale_factor": 0.7,
    "color": [0.25, 0.37, 0.22],
    "size": ["100%", 30]
  },

  "generic_dynamic_divider": {
    "type": "image",
    "size": ["100% - 12px", 1],
    "offset": [0, 3],
    "texture": "textures/ui/creeper_menu/line",
    "color": [0.5, 0.44, 0.36]
  },

  "generic_button_icon": {
    "type": "image",
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "offset": [11, 0],
    "size": [22, 22],
    "bindings": [
      {
        "binding_name": "#form_button_texture",
        "binding_name_override": "#texture",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_texture_file_system",
        "binding_name_override": "#texture_file_system",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
        "target_property_name": "#visible"
      }
    ]
  },

  "close_button@common.button": {
    "variables": [
      {
        "requires": "$touch",
        "$cm_close_button_size": [30, 30],
        "$cm_close_visual_size": [24, 24]
      },
      {
        "requires": "(not $touch)",
        "$cm_close_button_size": [24, 24],
        "$cm_close_visual_size": [24, 24]
      }
    ],
    "size": "$cm_close_button_size",
    "$pressed_button_name": "button.menu_exit",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "locked_control": "default",
    "controls": [
      {
        "default@creeper_menu.close_state": {
          "$cm_close_texture": "textures/ui/creeper_menu/close_default",
          "$cm_close_offset": [0, 0]
        }
      },
      {
        "hover@creeper_menu.close_state": {
          "$cm_close_texture": "textures/ui/creeper_menu/close_hover",
          "$cm_close_offset": [0, 0]
        }
      },
      {
        "pressed@creeper_menu.close_state": {
          "$cm_close_texture": "textures/ui/creeper_menu/close_pressed",
          "$cm_close_offset": [0, 1]
        }
      }
    ]
  },

  "close_state": {
    "type": "image",
    "size": "$cm_close_visual_size",
    "offset": "$cm_close_offset",
    "keep_ratio": false,
    "texture": "$cm_close_texture",
    "layer": 8
  },

  "card_player@creeper_menu.card": {
    "$cm_art_texture": "textures/ui/creeper_menu/cards/player",
    "$cm_default_texture": "textures/ui/creeper_menu/cards/player_default",
    "$cm_hover_texture": "textures/ui/creeper_menu/cards/player_hover",
    "$cm_pressed_texture": "textures/ui/creeper_menu/cards/player_pressed"
  },

  "card_waypoint@creeper_menu.card": {
    "$cm_art_texture": "textures/ui/creeper_menu/cards/waypoint",
    "$cm_default_texture": "textures/ui/creeper_menu/cards/waypoint_default",
    "$cm_hover_texture": "textures/ui/creeper_menu/cards/waypoint_hover",
    "$cm_pressed_texture": "textures/ui/creeper_menu/cards/waypoint_pressed"
  },

  "card_land@creeper_menu.card": {
    "$cm_art_texture": "textures/ui/creeper_menu/cards/land",
    "$cm_default_texture": "textures/ui/creeper_menu/cards/land_default",
    "$cm_hover_texture": "textures/ui/creeper_menu/cards/land_hover",
