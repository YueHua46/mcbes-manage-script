{
  "namespace": "creeper_menu",

  "long_form_router": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "main_menu@creeper_menu.form_type": {
          "$min": "/CMROOT ",
          "$max": "/CMROOT 􀐏",
          "$content": "creeper_menu.root"
        }
      },
      {
        "project_action_form@creeper_menu.form_type": {
          "$min": "/CMFORM ",
          "$max": "/CMFORM 􀐏",
          "$content": "creeper_menu.generic_long_form"
        }
      }
    ]
  },

  "form_type": {
    "type": "panel",
    "size": ["100%", "100%"],
    "visible": false,
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#title_text = $min) or (#title_text > $min and #title_text < $max)",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#title_text - $min)",
        "target_property_name": "#title"
      }
    ],
    "controls": [
      {
        "content@$content": {}
      }
    ]
  },

  "root": {
    "type": "panel",
    "size": ["100%", "100%"],
    "variables": [
      {
        "requires": "$touch",
        "$cm_dialog_size": ["97%", "93%"],
        "$cm_title_scale": 0.82
      },
      {
        "requires": "(not $touch)",
        "$cm_dialog_size": ["95%", "92%"],
        "$cm_title_scale": 0.92
      }
    ],
    "controls": [
      {
        "dialog": {
          "type": "panel",
          "size": "$cm_dialog_size",
          "max_size": [920, 510],
          "min_size": [310, 205],
          "layer": 2,
          "controls": [
            {
              "header@creeper_menu.header": {}
            },
            {
              "content@creeper_menu.content": {}
            }
          ]
        }
      }
    ]
  },

  "header": {
    "type": "panel",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "size": ["100%", 34],
    "offset": [0, 0],
    "layer": 6,
    "controls": [
      {
        "title": {
          "type": "label",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [3, 0],
          "text": "主菜单",
          "font_size": "large",
          "font_scale_factor": "$cm_title_scale",
          "color": [1.0, 0.98, 0.92],
          "shadow": true,
          "layer": 7
        }
      },
      {
        "close_frame": {
          "type": "image",
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [-3, 0],
          "size": [24, 24],
          "texture": "textures/ui/creeper_menu/close_frame",
          "layer": 6
        }
      },
      {
        "close_button@common.close_button": {
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [-3, 0],
          "$close_button_to_button_id": "button.menu_exit"
        }
      }
    ]
  },

  "content": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "size": ["100%", "100% - 38px"],
    "offset": [0, -1],
    "layer": 4,
    "controls": [
      {
        "left@creeper_menu.left_mosaic": {}
      },
      {
        "column_gap": {
          "type": "panel",
          "size": [4, "100%"]
        }
      },
      {
        "right@creeper_menu.right_mosaic": {}
      }
    ]
  },

  "left_mosaic": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": ["66%", "100%"],
    "controls": [
      {
        "row_1@creeper_menu.row_one": {}
      },
      {
        "row_gap_1": {
          "type": "panel",
          "size": ["100%", 4]
        }
      },
      {
        "row_2@creeper_menu.row_two": {}
      },
      {
        "row_gap_2": {
          "type": "panel",
          "size": ["100%", 4]
        }
      },
      {
        "row_3@creeper_menu.row_three": {}
      }
    ]
  },

  "row_one": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": ["100%", "33.33% - 3px"],
    "collection_name": "form_buttons",
    "controls": [
      {
        "player@creeper_menu.card_player": {
          "size": ["33.33% - 3px", "100%"],
          "$cm_index": 0
        }
      },
      {
        "gap_1@creeper_menu.card_gap": {}
      },
      {
        "waypoint@creeper_menu.card_waypoint": {
          "size": ["33.33% - 3px", "100%"],
          "$cm_index": 1
        }
      },
      {
        "gap_2@creeper_menu.card_gap": {}
      },
      {
        "land@creeper_menu.card_land": {
          "size": ["33.34%", "100%"],
          "$cm_index": 2
        }
      }
    ]
  },

  "row_two": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": ["100%", "33.34% - 2px"],
    "collection_name": "form_buttons",
    "controls": [
      {
        "economy@creeper_menu.card_economy": {
          "size": ["50% - 2px", "100%"],
          "$cm_index": 3
        }
      },
      {
        "gap_1@creeper_menu.card_gap": {}
      },
      {
        "guild@creeper_menu.card_guild": {
          "size": ["50% - 2px", "100%"],
          "$cm_index": 4
        }
      }
    ]
  },

  "row_three": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": ["100%", "33.33% - 3px"],
    "collection_name": "form_buttons",
    "controls": [
      {
        "pvp@creeper_menu.card_pvp": {
          "size": ["33.33% - 3px", "100%"],
          "$cm_index": 6
        }
      },
      {
        "gap_1@creeper_menu.card_gap": {}
      },
      {
        "stats@creeper_menu.card_stats": {
          "size": ["33.33% - 3px", "100%"],
          "$cm_index": 7
        }
      },
      {
        "gap_2@creeper_menu.card_gap": {}
      },
      {
        "other@creeper_menu.card_other": {
          "size": ["33.34%", "100%"],
          "$cm_index": 9
        }
      }
    ]
  },

  "right_mosaic": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": ["34% - 4px", "100%"],
    "collection_name": "form_buttons",
    "controls": [
      {
        "quest@creeper_menu.card_quest": {
          "size": ["100%", "52% - 3px"],
          "$cm_index": 8
        }
      },
      {
        "right_gap_1@creeper_menu.card_gap_vertical": {}
      },
      {
        "menu_item@creeper_menu.card_menu_item": {
          "size": ["100%", "23% - 3px"],
          "$cm_index": 11
        }
      },
      {
        "right_gap_2@creeper_menu.card_gap_vertical": {}
      },
      {
        "quick_row": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": ["100%", "25% - 2px"],
          "collection_name": "form_buttons",
          "controls": [
            {
              "floating_text@creeper_menu.card_floating_text": {
                "size": ["33.33% - 3px", "100%"],
                "$cm_index": 5
              }
            },
            {
              "gap_1@creeper_menu.card_gap": {}
            },
            {
              "help@creeper_menu.card_help": {
                "size": ["33.33% - 3px", "100%"],
                "$cm_index": 10
              }
            },
            {
              "gap_2@creeper_menu.card_gap": {}
            },
            {
              "server_settings@creeper_menu.card_server_settings": {
                "size": ["33.34%", "100%"],
                "$cm_index": 12
              }
            }
          ]
        }
      }
    ]
  },

  "card_gap": {
    "type": "panel",
    "size": [4, "100%"]
  },

  "card_gap_vertical": {
    "type": "panel",
    "size": ["100%", 4]
  },

  "generic_long_form": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "dialog": {
          "type": "image",
          "size": ["58%", "72%"],
          "max_size": [520, 380],
          "min_size": [280, 200],
          "texture": "textures/ui/creeper_menu/submenu_panel",
          "layer": 2,
          "controls": [
            {
              "header@creeper_menu.generic_header": {}
            },
            {
              "scroll@common.scrolling_panel": {
                "anchor_from": "bottom_middle",
                "anchor_to": "bottom_middle",
                "size": ["100% - 14px", "100% - 50px"],
                "offset": [0, -5],
                "$show_background": false,
                "$scrolling_content": "creeper_menu.generic_long_form_content",
                "$scroll_size": [2, "100% - 4px"],
                "$scrolling_pane_size": ["100% - 5px", "100%"],
                "$scroll_bar_right_padding_size": [0, 0],
                "layer": 4
              }
            }
          ]
        }
      }
    ]
  },

  "generic_header": {
    "type": "panel",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "size": ["100% - 14px", 42],
    "offset": [0, 4],
    "controls": [
      {
        "title": {
          "type": "label",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [9, -5],
          "size": ["100% - 54px", 20],
          "font_size": "large",
          "font_scale_factor": 0.7,
          "color": [0.25, 0.22, 0.19],
          "shadow": false,
          "layer": 6,
          "text": "#form_text",
          "bindings": [
            {
              "binding_name": "#form_text"
            }
          ]
        }
      },
      {
        "subtitle": {
          "type": "label",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [10, 10],
          "size": ["100% - 56px", 12],
          "text": "选择一项继续",
          "font_scale_factor": 0.5,
          "color": [0.5, 0.43, 0.35],
          "layer": 6
        }
      },
      {
        "close_frame": {
          "type": "image",
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [-3, 0],
          "size": [24, 24],
          "texture": "textures/ui/creeper_menu/close_frame",
          "layer": 5
        }
      },
      {
        "close_button@common.close_button": {
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [-3, 0],
          "$close_button_to_button_id": "button.menu_exit"
        }
      }
    ]
  },

  "generic_long_form_content": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": ["100%", "100%c"],
    "controls": [
      {
        "buttons": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": ["100%", "100%c"],
          "factory": {
            "name": "buttons",
            "control_ids": {
              "button": "creeper_menu.generic_dynamic_button",
              "label": "creeper_menu.generic_dynamic_label",
              "header": "creeper_menu.generic_dynamic_header",
              "divider": "creeper_menu.generic_dynamic_divider"
            }
          },
          "collection_name": "form_buttons",
          "bindings": [
            {
              "binding_name": "#form_button_contents",
              "binding_name_override": "#collection_length"
            }
          ]
        }
      }
    ]
  },

  "generic_dynamic_button": {
    "type": "panel",
    "size": ["100%", 37],
    "visible": false,
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_text",
        "binding_name_override": "#text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#text = ''))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "button@common_buttons.light_text_button": {
          "size": ["100%", "100%"],
          "$pressed_button_name": "button.form_button_click",
          "$button_text": "#form_button_text",
          "$button_text_binding_type": "collection",
          "$button_text_grid_collection_name": "form_buttons",
          "$button_binding_condition": "none",
          "$button_font_scale_factor": 0.68,
          "$button_text_size": ["100% - 54px", 22],
          "$button_text_max_size": ["100% - 54px", 22],
          "$anchor": "left_middle",
          "$text_alignment": "left",
          "$button_offset": [43, 0],
          "$button_pressed_offset": [44, 1],
          "$default_button_texture": "textures/ui/creeper_menu/cards/generic_default",
          "$hover_button_texture": "textures/ui/creeper_menu/cards/generic_hover",
          "$pressed_button_texture": "textures/ui/creeper_menu/cards/generic_pressed",
          "$locked_button_texture": "textures/ui/creeper_menu/cards/generic_default",
          "$default_text_color": [0.25, 0.22, 0.19],
          "$hover_text_color": [0.18, 0.16, 0.14],
          "$pressed_text_color": [0.34, 0.29, 0.24],
          "$locked_text_color": [0.52, 0.49, 0.44],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      },
      {
        "icon_chip": {
          "type": "image",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [6, 0],
          "size": [28, 28],
          "texture": "textures/ui/creeper_menu/icon_chip",
          "layer": 7
        }
      },
      {
        "icon@creeper_menu.generic_button_icon": {
          "layer": 8
        }
      },
      {
        "chevron": {
          "type": "label",
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [-8, -1],
          "size": [12, 18],
          "text": "›",
          "font_size": "large",
          "font_scale_factor": 0.72,
          "color": [0.42, 0.36, 0.29],
          "layer": 9
        }
      }
    ]
  },

  "generic_dynamic_label": {
    "type": "label",
    "size": ["100% - 8px", "default"],
    "offset": [4, 2],
    "text": "#form_button_text",
    "color": [0.38, 0.33, 0.27],
    "font_scale_factor": 0.72,
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      }
    ]
  },

  "generic_dynamic_header@creeper_menu.generic_dynamic_label": {
    "font_size": "large",
    "font_scale_factor": 0.72,
    "color": [0.29, 0.25, 0.21],
    "size": ["100%", 26]
  },

  "generic_dynamic_divider": {
    "type": "image",
    "size": ["100%", 1],
    "texture": "textures/ui/creeper_menu/line",
    "color": [0.5, 0.44, 0.36]
  },

  "generic_button_icon": {
    "type": "image",
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "offset": [9, 0],
    "size": [22, 22],
    "bindings": [
      {
        "binding_name": "#form_button_texture",
        "binding_name_override": "#texture",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_texture_file_system",
        "binding_name_override": "#texture_file_system",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
        "target_property_name": "#visible"
      }
    ]
  },

  "card_player@creeper_menu.card": {
    "$cm_art_texture": "textures/ui/creeper_menu/cards/player",
    "$cm_default_texture": "textures/ui/creeper_menu/cards/player_default",
    "$cm_hover_texture": "textures/ui/creeper_menu/cards/player_hover",
    "$cm_pressed_texture": "textures/ui/creeper_menu/cards/player_pressed"
  },

  "card_waypoint@creeper_menu.card": {
    "$cm_art_texture": "textures/ui/creeper_menu/cards/waypoint",
    "$cm_default_texture": "textures/ui/creeper_menu/cards/waypoint_default",
    "$cm_hover_texture": "textures/ui/creeper_menu/cards/waypoint_hover",
    "$cm_pressed_texture": "textures/ui/creeper_menu/cards/waypoint_pressed"
  },

  "card_land@creeper_menu.card": {
    "$cm_art_texture": "textures/ui/creeper_menu/cards/land",
    "$cm_default_texture": "textures/ui/creeper_menu/cards/land_default",
    "$cm_hover_texture": "textures/ui/creeper_menu/cards/land_hover",
    "$cm_pressed_texture": "textures/ui/creeper_menu/cards/land_pressed"
  },

  "card_economy@creeper_menu.card": {
    "$cm_art_texture": "textures/ui/creeper_menu/cards/economy",
    "$cm_default_texture": "textures/ui/creeper_menu/cards/economy_default",
    "$cm_hover_texture": "textures/ui/creeper_menu/cards/economy_hover",
    "$cm_pressed_texture": "textures/ui/creeper_menu/cards/economy_pressed"
  },

  "card_guild@creeper_menu.card": {
    "$cm_art_texture": "textures/ui/creeper_menu/cards/guild",
    "$cm_default_texture": "textures/ui/creeper_menu/cards/guild_default",
    "$cm_hover_texture": "textures/ui/creeper_menu/cards/guild_hover",
    "$cm_pressed_texture": "textures/ui/creeper_menu/cards/guild_pressed"
  },

  "card_floating_text@creeper_menu.card": {
    "$cm_art_texture": "textures/ui/creeper_menu/cards/floating_text",
    "$cm_default_texture": "textures/ui/creeper_menu/cards/floating_text_default",
    "$cm_hover_texture": "textures/ui/creeper_menu/cards/floating_text_hover",
    "$cm_pressed_texture": "textures/ui/creeper_menu/cards/floating_text_pressed"
  },

  "card_pvp@creeper_menu.card": {
    "$cm_art_texture": "textures/ui/creeper_menu/cards/pvp",
    "$cm_default_texture": "textures/ui/creeper_menu/cards/pvp_default",
    "$cm_hover_texture": "textures/ui/creeper_menu/cards/pvp_hover",
    "$cm_pressed_texture": "textures/ui/creeper_menu/cards/pvp_pressed"
  },

  "card_stats@creeper_menu.card": {
    "$cm_art_texture": "textures/ui/creeper_menu/cards/stats",
    "$cm_default_texture": "textures/ui/creeper_menu/cards/stats_default",
    "$cm_hover_texture": "textures/ui/creeper_menu/cards/stats_hover",
    "$cm_pressed_texture": "textures/ui/creeper_menu/cards/stats_pressed"
  },

  "card_quest@creeper_menu.card": {
    "$cm_art_texture": "textures/ui/creeper_menu/cards/quest",
    "$cm_default_texture": "textures/ui/creeper_menu/cards/quest_default",
    "$cm_hover_texture": "textures/ui/creeper_menu/cards/quest_hover",
    "$cm_pressed_texture": "textures/ui/creeper_menu/cards/quest_pressed"
  },

  "card_other@creeper_menu.card": {
    "$cm_art_texture": "textures/ui/creeper_menu/cards/other",
    "$cm_default_texture": "textures/ui/creeper_menu/cards/other_default",
    "$cm_hover_texture": "textures/ui/creeper_menu/cards/other_hover",
    "$cm_pressed_texture": "textures/ui/creeper_menu/cards/other_pressed"
  },

  "card_help@creeper_menu.card": {
    "$cm_art_texture": "textures/ui/creeper_menu/cards/help",
    "$cm_default_texture": "textures/ui/creeper_menu/cards/help_default",
    "$cm_hover_texture": "textures/ui/creeper_menu/cards/help_hover",
    "$cm_pressed_texture": "textures/ui/creeper_menu/cards/help_pressed"
  },

  "card_menu_item@creeper_menu.card": {
    "$cm_art_texture": "textures/ui/creeper_menu/cards/menu_item",
    "$cm_default_texture": "textures/ui/creeper_menu/cards/menu_item_default",
    "$cm_hover_texture": "textures/ui/creeper_menu/cards/menu_item_hover",
    "$cm_pressed_texture": "textures/ui/creeper_menu/cards/menu_item_pressed"
  },

  "card_server_settings@creeper_menu.card": {
    "$cm_art_texture": "textures/ui/creeper_menu/cards/server_settings",
    "$cm_default_texture": "textures/ui/creeper_menu/cards/server_settings_default",
    "$cm_hover_texture": "textures/ui/creeper_menu/cards/server_settings_hover",
    "$cm_pressed_texture": "textures/ui/creeper_menu/cards/server_settings_pressed"
  },

  "card@common.button": {
    "collection_index": "$cm_index",
    "visible": false,
    "$pressed_button_name": "button.form_button_click",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "locked_control": "locked",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_text",
        "binding_name_override": "#text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#text = ''))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "default@creeper_menu.card_state": {
          "$cm_background_texture": "$cm_default_texture",
          "$cm_text_color": [1.0, 0.98, 0.93]
        }
      },
      {
        "hover@creeper_menu.card_state": {
          "$cm_background_texture": "$cm_hover_texture",
          "$cm_text_color": [1.0, 1.0, 0.96]
        }
      },
      {
        "pressed@creeper_menu.card_state": {
          "$cm_background_texture": "$cm_pressed_texture",
