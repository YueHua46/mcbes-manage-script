  "card@common.button": {
    "collection_index": "$cm_index",
    "visible": false,
    "$cm_art_size|default": [72, 72],
    "$pressed_button_name": "button.form_button_click",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "locked_control": "locked",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_text",
        "binding_name_override": "#text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#text = ''))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "default@creeper_menu.card_state": {
          "$cm_background_texture": "$cm_default_texture",
          "$cm_art_offset": [5, -5],
          "$cm_text_color": [0.92, 0.97, 0.91]
        }
      },
      {
        "hover@creeper_menu.card_state": {
          "$cm_background_texture": "$cm_hover_texture",
          "$cm_art_offset": [5, -7],
          "$cm_text_color": [0.82, 1.0, 0.48]
        }
      },
      {
        "pressed@creeper_menu.card_state": {
          "$cm_background_texture": "$cm_pressed_texture",
          "$cm_art_offset": [6, -3],
          "$cm_text_color": [0.66, 0.84, 0.51]
        }
      },
      {
        "locked@creeper_menu.card_state": {
          "$cm_background_texture": "$cm_default_texture",
          "$cm_art_offset": [5, -5],
          "$cm_text_color": [0.4, 0.48, 0.41],
          "alpha": 0.45
        }
      }
    ]
  },

  "card_state": {
    "type": "image",
    "size": ["100%", "100%"],
    "texture": "$cm_background_texture",
    "layer": 4,
    "controls": [
      {
        "art": {
          "type": "image",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": "$cm_art_offset",
          "size": "$cm_art_size",
          "texture": "$cm_art_texture",
          "layer": 5
        }
      },
      {
        "label": {
          "type": "label",
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [-7, -6],
          "size": ["100% - 10px", 15],
          "text": "#form_button_text",
          "text_alignment": "right",
          "font_scale_factor": 0.78,
          "color": "$cm_text_color",
          "shadow": true,
          "layer": 7,
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  }
}
