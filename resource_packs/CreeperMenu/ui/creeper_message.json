{
  "namespace": "creeper_message",

  "form": {
    "type": "panel",
    "size": ["100%", "100%"],
    "variables": [
      {
        "requires": "$touch",
        "$cm_message_size": ["78%", "82%"]
      },
      {
        "requires": "(not $touch)",
        "$cm_message_size": ["46%", "70%"]
      }
    ],
    "controls": [
      {
        "dialog": {
          "type": "image",
          "size": "$cm_message_size",
          "max_size": [520, 360],
          "texture": "textures/ui/creeper_menu/submenu_panel",
          "layer": 2,
          "controls": [
            {
              "header@creeper_message.header": {}
            },
            {
              "body_frame": {
                "type": "image",
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "size": ["100% - 16px", "100% - 116px"],
                "offset": [0, 68],
                "texture": "textures/ui/creeper_menu/content_sheet",
                "layer": 3,
                "controls": [
                  {
                    "body_scroll@common.scrolling_panel": {
                      "size": ["100%", "100% - 14px"],
                      "$show_background": false,
                      "$scrolling_content": "creeper_message.body_content",
                      "$scroll_size": [2, "100%"],
                      "$scrolling_pane_size": ["100%", "100%"],
                      "$scroll_bar_right_padding_size": [0, 0],
                      "layer": 4
                    }
                  }
                ]
              }
            },
            {
              "footer@creeper_message.footer": {}
            }
          ]
        }
      }
    ]
  },

  "header": {
    "type": "image",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "size": ["100% - 16px", 56],
    "offset": [0, 6],
    "texture": "textures/ui/creeper_menu/header_band",
    "controls": [
      {
        "emblem": {
          "type": "image",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [5, -1],
          "size": [43, 43],
          "texture": "textures/ui/creeper_menu/message_emblem",
          "layer": 7
        }
      },
      {
        "title": {
          "type": "label",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [50, -4],
          "size": ["100% - 94px", 20],
          "font_size": "large",
          "font_scale_factor": 0.76,
          "color": [1.0, 0.95, 0.8],
          "shadow": true,
          "layer": 6,
          "text": "#visible_title",
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - '/CMMESSAGE ')",
              "target_property_name": "#visible_title"
            }
          ]
        }
      },
      {
        "subtitle": {
          "type": "label",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [51, 7],
          "size": ["100% - 96px", 12],
          "text": "冒险手册 · 消息与确认",
          "font_scale_factor": 0.52,
          "color": [0.82, 0.78, 0.61],
          "shadow": false,
          "localize": false,
          "layer": 6
        }
      },
      {
        "close_button@creeper_menu.close_button": {
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [-5, 0]
        }
      }
    ]
  },

  "body_content": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": ["100% - 12px", "100%c"],
    "offset": [6, 0],
    "controls": [
      {
        "body": {
          "type": "label",
          "size": ["100%", "default"],
          "offset": [0, 2],
          "text": "#form_text",
          "text_alignment": "left",
          "color": [0.25, 0.22, 0.19],
          "font_scale_factor": 0.7,
          "line_padding": 2,
          "bindings": [
            {
              "binding_name": "#form_text"
            }
          ]
        }
      }
    ]
  },

  "footer": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "size": ["100% - 16px", 43],
    "offset": [0, -7],
    "collection_name": "form_buttons",
    "controls": [
      {
        "button_one@creeper_message.message_button": {
          "size": ["50% - 3px", 38],
          "$cm_index": 0
        }
      },
      {
        "button_gap": {
          "type": "panel",
          "size": [6, 38]
        }
      },
      {
        "button_two@creeper_message.message_button": {
          "size": ["50% - 3px", 38],
          "$cm_index": 1
        }
      }
    ]
  },

  "message_button@common.button": {
    "collection_index": "$cm_index",
    "visible": false,
    "$pressed_button_name": "button.form_button_click",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "locked_control": "locked",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_text",
        "binding_name_override": "#text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#text = ''))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "default@creeper_message.button_state": {
          "$cm_state_texture": "textures/ui/creeper_menu/cards/generic_default",
          "$cm_state_text_color": [0.2, 0.18, 0.16],
          "$cm_state_offset": [0, 0]
        }
      },
      {
        "hover@creeper_message.button_state": {
          "$cm_state_texture": "textures/ui/creeper_menu/cards/generic_hover",
          "$cm_state_text_color": [0.16, 0.14, 0.12],
          "$cm_state_offset": [0, 1]
        }
      },
      {
        "pressed@creeper_message.button_state": {
          "$cm_state_texture": "textures/ui/creeper_menu/cards/generic_pressed",
          "$cm_state_text_color": [0.29, 0.25, 0.21],
          "$cm_state_offset": [0, 2]
        }
      },
      {
        "locked@creeper_message.button_state": {
          "$cm_state_texture": "textures/ui/creeper_menu/cards/generic_default",
          "$cm_state_text_color": [0.52, 0.49, 0.44],
          "$cm_state_offset": [0, 0],
          "alpha": 0.55
        }
      }
    ]
  },

  "button_state": {
    "type": "image",
    "size": ["100%", "100%"],
    "offset": "$cm_state_offset",
    "keep_ratio": false,
    "texture": "$cm_state_texture",
    "layer": 5,
    "controls": [
      {
        "label": {
          "type": "label",
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [0, 0],
          "size": ["100% - 12px", "default"],
          "max_size": ["100% - 12px", 16],
          "text": "#form_button_text",
          "text_alignment": "center",
          "color": "$cm_state_text_color",
          "font_scale_factor": 0.7,
          "layer": 7,
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  }
}
